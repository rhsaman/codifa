{
  "name": "codifa",
  "version": "1.8.3",
  "description": "Offline-first AI coding assistant for your own machine — a real agent (Ask/Plan/Coder), voice input and RAG memory. Bring your own model: OpenRouter, OpenAI-compatible APIs or local LLMs.",
  "author": {
    "name": "rhsaman",
    "email": "rhsaman@users.noreply.github.com"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "coding-assistant",
    "offline-first",
    "local-llm",
    "rag",
    "langgraph",
    "whisper",
    "openrouter",
    "ollama",
    "monaco-editor",
    "desktop-app",
    "typescript",
    "python"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhsaman/codifa.git"
  },
  "homepage": "https://github.com/rhsaman/codifa",
  "type": "module",
  "scripts": {
    "setup": "uv sync --project backend",
    "dev": "vite",
    "dev:web": "vite --mode webonly",
    "dev:agent": "vite --mode webonly --port 5174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:backend": "cd backend && .venv/bin/python -m pytest tests/ -q",
    "test:frontend": "bash tests/run-frontend.sh",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('release',{recursive:true,force:true}))\"",
    "dist": "npm run tauri build",
    "dist:mac": "npm run tauri build -- --target aarch64-apple-darwin",
    "dist:win": "npm run tauri build -- --target x86_64-pc-windows-msvc",
    "dist:linux": "npm run tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^11.17.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.10.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  }
}
