pytest_full_result.txt
tests/.tmp-*
tests/.fe-run.*
tests/dump-ssr.out.mjs
.tmp-*.mjs
# Throwaway live-probe scripts (scratch harnesses for manual verification —
# never part of the suite).
.probe-*.py
.probe-*.mjs
.probe-*.ts
.probe-*.sh

# Browser-automation temp files (logs, snapshots)
.playwright-mcp/

