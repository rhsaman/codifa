# ============================================================
# Node.js / npm / yarn / pnpm / bun
# ============================================================
# The Tauri shell IS tracked (Rust sources, config, icons) — only its build
# output and generated artifacts are ignored below.
node_modules/
bower_components/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
.pnp.*
.yarn/cache/
.yarn/install-state.gz
.yarn/unplugged/
.npm/
.yarnrc.yml.local
*.tgz
bun.lockb.meta
.bun-cache/

# Downloaded on-device ML models (fetched at runtime, not committed):
models--*/
MEMORY.md

# ============================================================
# Build output (renderer + Tauri bundle)
# ============================================================
dist/
release/
out/
.vite/
src-tauri/target/
src-tauri/gen/schemas/
*.blockmap

# ============================================================
# Test temp artifacts (real test files ARE tracked — see tests/)
